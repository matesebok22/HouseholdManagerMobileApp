<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HouseholdManagerMobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HouseholdManagerMobileApp"
    xmlns:views="clr-namespace:HouseholdManagerMobileApp.Views"
    FlyoutBehavior="Disabled"
    Title="HouseholdManagerMobileApp">

    <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:RegistrationPage}" Route="RegistrationPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:UserPage}" Route="UserPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:EventLogPage}" Route="EventLogPage"/>
    <ShellContent ContentTemplate="{DataTemplate views:NewEventPage}" Route="NewEventPage"/>
</Shell>