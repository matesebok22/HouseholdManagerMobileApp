<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HouseholdManagerMobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HouseholdManagerMobileApp"
    xmlns:views="clr-namespace:HouseholdManagerMobileApp.Views"
    FlyoutBehavior="Disabled"
    Title="HouseholdManagerMobileApp">

    <ShellContent Title="Login" ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage"/>
    <ShellContent Title="Registration" ContentTemplate="{DataTemplate views:RegistrationPage}" Route="RegistrationPage"/>
</Shell>