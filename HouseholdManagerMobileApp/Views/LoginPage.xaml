<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HouseholdManagerMobileApp.Views.LoginPage"
             BackgroundColor="#1F1F1F">
    
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Bejelentkezés" FontSize="Large" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
        <Label Text="Offline mód" FontSize="Large" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" IsVisible="{Binding IsOffline}"/>

        <Entry Placeholder="Felhasználónév" Text="{Binding Username}" TextColor="#FFFFFF" ReturnType="Next"/>
        <Entry Placeholder="Jelszó" IsPassword="True" Text="{Binding Password}" IsVisible="{Binding IsOnline}" TextColor="#FFFFFF" ReturnType="Send" ReturnCommand="{Binding LoginButtonCommand}"/>

        <Button Text="Bejelentkezés" TextColor="#FFFFFF" Command="{Binding LoginButtonCommand}"/>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#FFFFFF"/>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
            <Label Text="Nincs fiókod? " TextColor="#FFFFFF"/>
            <Label Text="Regisztrálj!" TextColor="#FFFFFF" TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToRegistrationCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>