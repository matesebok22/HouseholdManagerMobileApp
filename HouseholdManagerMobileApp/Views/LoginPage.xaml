<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HouseholdManagerMobileApp.Views.LoginPage"
             Title="Login Page">
    
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Entry Placeholder="Felhasználónév" Text="{Binding Username}"/>
        <Entry Placeholder="Jelszó" IsPassword="True" Text="{Binding Password}"/>

        <Button Text="Bejelentkezés" Command="{Binding LoginButtonCommand}"/>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
            <Label Text="Nincs fiókod? "/>
            <Label Text="Regisztrálj!" TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToRegistrationCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

        <Label Text="{Binding ErrorMessage}" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>