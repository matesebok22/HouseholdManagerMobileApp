<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HouseholdManagerMobileApp.Core.Models;assembly=HouseholdManagerMobileApp.Core"
             x:Class="HouseholdManagerMobileApp.Views.EventLogPage">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Fejléc -->
        <Grid ColumnDefinitions="Auto,*" Padding="10" BackgroundColor="Grey">
            <Button Grid.Column="0" Text="☰" FontSize="24" Command="{Binding ToggleMenuButtonCommand}" BackgroundColor="Grey" TextColor="White" Padding="0" WidthRequest="44"/>
            <Label Grid.Column="1" Text="{Binding WelcomeMessage}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Menü -->
        <Grid Grid.Row="1" IsVisible="{Binding IsMenuVisible}" BackgroundColor="DarkGrey" WidthRequest="250" ZIndex="30" Padding="0" HorizontalOptions="Start">
            <VerticalStackLayout Padding="20" Spacing="10">
                <Button Text="Kezdőlap" Command="{Binding NavigateHomeButtonCommand}" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Eseménynapló" IsEnabled="False" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Beállítások" Command="{Binding NavigateSettingsButtonCommand}" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Kijelentkezés" Command="{Binding LogoutButtonCommand}" BackgroundColor="#e65247" TextColor="White"/>
            </VerticalStackLayout>
        </Grid>

        <BoxView Grid.Row="1" BackgroundColor="Black" Opacity="0.7" IsVisible="{Binding IsMenuVisible}" ZIndex="20"/>

        <!-- Fő tartalom -->
        <VerticalStackLayout Grid.Row="1" Padding="10">
            <Label Text="{Binding CurrentHouseholdName}" HorizontalOptions="Center" FontSize="30"/>
            <Button Text="Új esemény létrehozása" Command="{Binding NavigateNewEventButtonCommand}" Margin="20, 10, 20, 10"/>

            <CollectionView ItemsSource="{Binding EventLog}">

                <!-- Hogyan nézzen ki EGY darab elem a listában -->
                <CollectionView.ItemTemplate>

                    <!-- DataType megadása (opcionális, de ajánlott), így lesz IntelliSense a XAML-ben -->
                    <DataTemplate x:DataType="models:Event">

                        <!-- Kártyaszerű megjelenés egy keretben -->
                        <Border BackgroundColor="LightBlue" Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">

                                <!-- Esemény neve -->
                                <Label FontAttributes="Bold" FontSize="18" Grid.Column="0" Grid.Row="0" Text="{Binding EventName}" TextColor="Black"/>

                                <!-- Esemény költsége (StringFormat-tal formázva) -->
                                <Label FontAttributes="Bold" FontSize="16" Grid.Column="1" Grid.Row="0" Text="{Binding EventCost, StringFormat='{0} Ft'}" TextColor="DarkGreen"/>

                                <!-- Dátum (Formázott megjelenítés) -->
                                <Label FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding EventUserDate, StringFormat='{0:yyyy. MM. dd. HH:mm}'}" TextColor="Red"/>

                                <!-- Leírás -->
                                <Label Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" LineBreakMode="WordWrap" Margin="0,5,0,0" Text="{Binding EventDescription}"/>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Ha a lista üres, ezt mutatja -->
                <CollectionView.EmptyView>
                    <Label HorizontalOptions="Center" Text="Nincsenek megjeleníthető események." VerticalOptions="Center"/>
                </CollectionView.EmptyView>

            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>