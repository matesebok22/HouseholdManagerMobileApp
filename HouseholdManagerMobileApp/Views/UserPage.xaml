<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HouseholdManagerMobileApp.Core.Models;assembly=HouseholdManagerMobileApp.Core"
             xmlns:vm="clr-namespace:HouseholdManagerMobileApp.Core.ViewModels;assembly=HouseholdManagerMobileApp.Core"
             xmlns:helpers="clr-namespace:HouseholdManagerMobileApp.Core.Helpers;assembly=HouseholdManagerMobileApp.Core"
             x:Class="HouseholdManagerMobileApp.Views.UserPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:StringEqualsToBooleanConverter x:Key="StringEqualsToBooleanConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Fejléc -->
        <Grid ColumnDefinitions="Auto,*" Padding="10" BackgroundColor="Grey">
            <Button Grid.Column="0" Text="☰" FontSize="24" Command="{Binding ToggleMenuButtonCommand}" BackgroundColor="Grey" TextColor="White" Padding="0" WidthRequest="44"/>
            <Label Grid.Column="1" Text="{Binding WelcomeMessage}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- Menü -->
        <Grid Grid.Row="1" IsVisible="{Binding IsMenuVisible}" BackgroundColor="DarkGrey" WidthRequest="250" ZIndex="30" Padding="0" HorizontalOptions="Start">
            <VerticalStackLayout Padding="20" Spacing="10">
                <Button Text="Kezdőlap"  IsEnabled="False" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Eseménynapló" Command="{Binding NavigateEventLogButtonCommand}" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Értesítések" Command="{Binding NavigateNotificationsButtonCommand}" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Beállítások" Command="{Binding NavigateSettingsButtonCommand}" BackgroundColor="DarkGrey" TextColor="White"/>
                <Button Text="Kijelentkezés" Command="{Binding LogoutButtonCommand}" BackgroundColor="#F44336" TextColor="White"/>
            </VerticalStackLayout>
        </Grid>

        <BoxView Grid.Row="1" BackgroundColor="Black" Opacity="0.7" IsVisible="{Binding IsMenuVisible}" ZIndex="20"/>

        <!-- Fő tartalom -->
        <Grid Grid.Row="1" RowDefinitions="150, Auto, *">
            <!-- Értesítések szekció -->
            <Grid Grid.Row="0" Margin="5">
                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 6" Margin="0, 10, 0, 0" Padding="10">
                    <CollectionView ItemsSource="{Binding UnreadNotifications}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Notification">
                                <Border BackgroundColor="NavajoWhite" Padding="5" StrokeShape="RoundRectangle 10">
                                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" TextColor="Black" FontAttributes="Bold"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{0:yyyy. MM. dd. HH:mm}'}" TextColor="Red"/>
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" TextColor="Black"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <Label HorizontalOptions="Center" Text="Nincsenek új értesítések." Margin="0, 40, 0, 0"/>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </Border>

                <Label Text="Értesítések" BackgroundColor="#202020" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Start" Margin="10, 0, 0, 0" Padding="5, 0"/>
            </Grid>

            <!-- Költségkeret szekció -->
            <Grid Grid.Row="1" Margin="5">
                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 6" Margin="0, 10, 0, 0" Padding="10">
                    <Grid RowDefinitions="Auto, *, *" ColumnDefinitions="*, *">
                        <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding CurrentMonth}" HorizontalOptions="Center" FontSize="Medium" TextTransform="Uppercase" Margin="0, 0, 0, 5"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Összes" HorizontalTextAlignment="Center"/>
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding CurrentMonthBudget}" HorizontalTextAlignment="Center" FontSize="Medium" FontAttributes="Bold" Margin="0, 5, 0, 0"/>

                        <Label Grid.Row="1" Grid.Column="1" Text="Felhasználható" HorizontalTextAlignment="Center"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding CurrentMonthUseableBudget}" HorizontalTextAlignment="Center" FontSize="Medium" FontAttributes="Bold" TextColor="Green" Margin="0, 5, 0, 0"/>
                    </Grid>
                </Border>

                <Label Text="Költségkeret" BackgroundColor="#202020" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Start" Margin="10, 0, 0, 0" Padding="5, 0"/>
            </Grid>

            <!-- Eseménynapló szekció -->
            <Grid Grid.Row="2" Margin="5">
                <Border Stroke="Gray" StrokeThickness="1" StrokeShape="RoundRectangle 6" Margin="0, 10, 0, 0" Padding="10">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <Label Grid.Row="0" Text="{Binding CurrentWeekLabel}" HorizontalOptions="Center" FontSize="Medium"/>

                        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *, *, *, *" Margin="0, 5, 0, 10" ColumnSpacing="5">
                            <Button Grid.Column="0" Text="H" Command="{Binding MondayEventsButtonCommand}"/>
                            <Button Grid.Column="1" Text="K" Command="{Binding TuesdayEventsButtonCommand}"/>
                            <Button Grid.Column="2" Text="Sze" Padding="0" Command="{Binding WednesdayEventsButtonCommand}"/>
                            <Button Grid.Column="3" Text="Cs" Command="{Binding ThursdayEventsButtonCommand}"/>
                            <Button Grid.Column="4" Text="P" Command="{Binding FridayEventsButtonCommand}"/>
                            <Button Grid.Column="5" Text="Szo" Padding="0" Command="{Binding SaturdayEventsButtonCommand}"/>
                            <Button Grid.Column="6" Text="V" Command="{Binding SundayEventsButtonCommand}"/>
                        </Grid>

                        <CollectionView Grid.Row="2" ItemsSource="{Binding EventLog}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Event">
                                    <Border BackgroundColor="LightBlue" Margin="0,0,0,10" Padding="15" StrokeShape="RoundRectangle 10">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserViewModel}}, Path=ToggleEventExpandCommand}" CommandParameter="{Binding .}"/>
                                                </Grid.GestureRecognizers>

                                                <Label FontAttributes="Bold" FontSize="18" Grid.Column="0" Grid.Row="0" Text="{Binding EventName}" TextColor="Black"/>

                                                <Label FontAttributes="Bold" FontSize="16" Grid.Column="1" Grid.Row="0" Text="{Binding EventCost, StringFormat='{0} Ft'}" TextColor="DarkGreen"/>

                                                <Label FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding EventUserDate, StringFormat='{0:yyyy. MM. dd. HH:mm}'}" TextColor="Red"/>
                                            </Grid>

                                            <!-- Kinyíló rész -->
                                            <VerticalStackLayout Padding="15" Spacing="8">
                                                <VerticalStackLayout.IsVisible>
                                                    <MultiBinding Converter="{StaticResource StringEqualsToBooleanConverter}">
                                                        <!-- 1. érték: -->
                                                        <Binding Path="EID"/>
                                                        <!-- 2. érték: -->
                                                        <Binding Path="ExpandedEventId" Source="{RelativeSource AncestorType={x:Type vm:UserViewModel}}"/>
                                                    </MultiBinding>
                                                </VerticalStackLayout.IsVisible>

                                                <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="15,0"/>

                                                <!-- Plusz információk -->
                                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                                    <Label Grid.Column="0" Grid.Row="0" FontAttributes="Bold" Text="Esemény létrehozása: " TextColor="Black"/>
                                                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding EventDate, StringFormat='{0:yyyy. MM. dd. HH:mm}'}" TextColor="Black"/>

                                                    <Label Grid.Column="0" Grid.Row="1" FontAttributes="Bold" Text="Típus: " TextColor="Black" Margin="0,8,0,0"/>
                                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding EventType}" TextColor="Black" Margin="0,8,0,0"/>
                                                </Grid>

                                                <Label FontAttributes="Bold" Text="Leírás:" TextColor="Black"/>
                                                <Label Text="{Binding EventDescription}" TextColor="Black" LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label HorizontalOptions="Center" Text="Nincsenek megjeleníthető események." VerticalOptions="Center"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </Grid>
                </Border>

                <Label Text="Eseménynapló" BackgroundColor="#202020" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Start" Margin="10, 0, 0, 0" Padding="5, 0"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>