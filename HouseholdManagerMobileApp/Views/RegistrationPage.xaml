<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HouseholdManagerMobileApp.Views.RegistrationPage"
             BackgroundColor="#1F1F1F">
    
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Regisztráció" TextColor="#FFFFFF" FontSize="Large" FontAttributes="Bold" HorizontalOptions="Center"/>

        <Entry Placeholder="Felhasználónév" Text="{Binding Username}" TextColor="#FFFFFF"/>
        <Entry Placeholder="Becenév" Text="{Binding Nickname}" TextColor="#FFFFFF"/>
        <Entry Placeholder="Jelszó" IsPassword="True" Text="{Binding Password}" TextColor="#FFFFFF"/>
        <Entry Placeholder="Jelszó megerősítése" IsPassword="True" Text="{Binding ConfirmPassword}" TextColor="#FFFFFF"/>

        <Button Text="Regisztráció" TextColor="#FFFFFF" Command="{Binding RegisterButtonCommand}"/>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
            <Label Text="Van fiókod? " TextColor="#FFFFFF"/>
            <Label Text="Jelentkezz be!" TextColor="#FFFFFF" TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>